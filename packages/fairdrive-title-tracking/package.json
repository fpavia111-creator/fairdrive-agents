    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairdrive-title-tracking": "bin/fairdrive-title-tracking.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
