{"suite": "fairdrive-gl-schedules", "root": "..", "data_note": "Fictional schedule detail and ledger balances in ../fixtures, as of 2026-11-15. No model is called.", "pii_none": "Reads schedule and control numbers, short descriptions, dates and amounts; the fixtures and the agent's columns hold no customer data.", "cases": [{"id": "totals", "tool": "schedules_age", "args": {"detail": "fixtures/schedule-detail.csv", "balances": "fixtures/gl-balances.csv", "as_of": "2026-11-15"}, "expect": {"equals": {"result.schedules": 3, "result.out_of_balance": 2, "result.open_total": 65210, "result.over_90_controls": 2, "result.over_90_amount": 10300, "result.zero_balance_controls": 2, "result.credit_balances": 1}}}, {"id": "out-of-balance-first", "tool": "schedules_age", "args": {"detail": "fixtures/schedule-detail.csv", "balances": "fixtures/gl-balances.csv", "as_of": "2026-11-15"}, "expect": {"equals": {"result.items.0.schedule": "220", "result.items.0.amount": -500, "result.items.1.amount": -340, "result.items.2.control_number": "D2004", "result.items.4.finding": "credit_balance"}, "length": {"result.items": 7}}}, {"id": "by-schedule", "tool": "schedules_age", "args": {"detail": "fixtures/schedule-detail.csv", "balances": "fixtures/gl-balances.csv", "as_of": "2026-11-15"}, "expect": {"equals": {"result.by_schedule.0.difference": 0, "result.by_schedule.0.over_90": 8200, "result.by_schedule.1.open_controls": 2, "result.by_schedule.2.detail_total": 2410}}}, {"id": "cit-is-not-a-credit-check", "tool": "schedules_age", "args": {"detail": "fixtures/schedule-detail.csv", "balances": "fixtures/gl-balances.csv", "as_of": "2026-11-15"}, "expect": {"contains": ["ready to clear", "paid twice"]}}, {"id": "earlier-date", "tool": "schedules_age", "args": {"detail": "fixtures/schedule-detail.csv", "balances": "fixtures/gl-balances.csv", "as_of": "2026-10-15"}, "expect": {"equals": {"result.over_90_controls": 1, "result.over_90_amount": 2100}}}, {"id": "tolerance-does-not-hide-real-differences", "tool": "schedules_age", "args": {"detail": "fixtures/schedule-detail.csv", "balances": "fixtures/gl-balances.csv", "as_of": "2026-11-15", "tolerance": 100}, "expect": {"equals": {"result.out_of_balance": 2, "result.credit_balances": 1}}}, {"id": "write-report", "tool": "schedules_write_report", "args": {"detail": "fixtures/schedule-detail.csv", "balances": "fixtures/gl-balances.csv", "as_of": "2026-11-15"}, "expect": {"status": "executed", "length": {"result.files": 2}, "contains": ["3 schedule(s), 65210 in detail"]}}, {"id": "missing-balances-named", "tool": "schedules_age", "args": {"detail": "fixtures/schedule-detail.csv"}, "expect": {"status": "error", "contains": ["balances"]}}]}
