    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairdrive-gl-schedules": "bin/fairdrive-gl-schedules.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairdrive-gl-schedules.js demo",
    "eval": "node bin/fairdrive-gl-schedules.js eval"
  },
  "dependencies": {
    "fairdrive-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairdrive-agents.git",
