{
  "name": "andalusian-of-cancellations",
  "version": "0.1.0",
  "description": "Andalusian of Cancellations: recomputes the dealer chargeback on every cancelled F&I product (service contract, GAP, maintenance, appearance) from the product's profit and the unused share of its term, flags chargebacks above that figure or above the profit earned, and refunds not yet sent, and drafts a dispute to the provider. Never cancels a product or issues a refund.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "andalusian-of-cancellations": "bin/andalusian-of-cancellations.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/andalusian-of-cancellations.js demo",
    "eval": "node bin/andalusian-of-cancellations.js eval"
  },
  "dependencies": {
    "fairdrive-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairdrive-agents.git",
    "directory": "packages/andalusian-of-cancellations"
  },
  "homepage": "https://github.com/fpavia111-creator/fairdrive-agents/tree/main/packages/andalusian-of-cancellations#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/fairdrive-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "auto-dealer",
    "car-dealership",
    "dealership",
    "fairdrive",
    "f-and-i",
    "chargebacks",
    "product-cancellations",
    "service-contracts",
    "gap"
  ]
}
