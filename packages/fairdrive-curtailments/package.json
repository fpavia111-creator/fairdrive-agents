{
  "name": "fairdrive-curtailments",
  "version": "0.1.0",
  "description": "Fairdrive Curtailments: works out the curtailment (principal pay-down) each floored unit owes under your lender schedule, lists what is overdue and what falls due in the coming weeks, and totals it by week. Never pays a lender.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairdrive-curtailments": "bin/fairdrive-curtailments.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairdrive-curtailments.js demo",
    "eval": "node bin/fairdrive-curtailments.js eval"
  },
  "dependencies": {
    "fairdrive-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairdrive-agents.git",
    "directory": "packages/fairdrive-curtailments"
  },
  "homepage": "https://github.com/fpavia111-creator/fairdrive-agents/tree/main/packages/fairdrive-curtailments#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/fairdrive-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "auto-dealer",
    "car-dealership",
    "dealership",
    "fairdrive",
    "floorplan",
    "curtailments",
    "inventory",
    "cash-planning"
  ]
}
