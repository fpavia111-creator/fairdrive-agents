{
  "suite": "fairdrive-curtailments",
  "root": "..",
  "data_note": "Fictional floorplan statement in ../fixtures, as of 2026-11-15, default schedules. No model is called.",
  "pii_none": "Reads the floorplan statement: VINs, stock numbers, dates and balances, no customer data.",
  "cases": [
    {
      "id": "totals",
      "tool": "curtailments_schedule",
      "args": {
        "statement": "fixtures/statement.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "equals": {
          "result.units": 7,
          "result.balance": 185800,
          "result.overdue_units": 3,
          "result.overdue_amount": 17100,
          "result.due_soon_units": 2,
          "result.due_soon_amount": 4500
        }
      }
    },
    {
      "id": "overdue-first",
      "tool": "curtailments_schedule",
      "args": {
        "statement": "fixtures/statement.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "equals": {
          "result.items.0.finding": "overdue",
          "result.items.0.stock_number": "U6107",
          "result.items.0.amount": 9600,
          "result.items.3.due_date": "2026-11-18",
          "result.items.4.due_date": "2026-11-19"
        }
      }
    },
    {
      "id": "past-last-step-is-payoff",
      "tool": "curtailments_schedule",
      "args": {
        "statement": "fixtures/statement.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "contains": [
          "past the last step of the schedule: the whole balance (9600) is due"
        ]
      }
    },
    {
      "id": "by-week",
      "tool": "curtailments_schedule",
      "args": {
        "statement": "fixtures/statement.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "equals": {
          "result.by_week.0.amount": 4500,
          "result.by_week.0.units": 2,
          "result.by_week.1.amount": 0
        },
        "length": {
          "result.by_week": 4
        }
      }
    },
    {
      "id": "own-schedule",
      "tool": "curtailments_schedule",
      "args": {
        "statement": "fixtures/statement.csv",
        "as_of": "2026-11-15",
        "schedule": [
          {
            "day": 120,
            "pct": 20
          },
          {
            "day": 240,
            "pct": 100
          }
        ]
      },
      "expect": {
        "equals": {
          "result.overdue_amount": 13100
        }
      }
    },
    {
      "id": "shorter-horizon",
      "tool": "curtailments_schedule",
      "args": {
        "statement": "fixtures/statement.csv",
        "as_of": "2026-11-15",
        "weeks": 1
      },
      "expect": {
        "equals": {
          "result.due_soon_amount": 4500
        },
        "length": {
          "result.by_week": 1
        }
      }
    },
    {
      "id": "write-report",
      "tool": "curtailments_write_report",
      "args": {
        "statement": "fixtures/statement.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "executed",
        "length": {
          "result.files": 2
        },
        "contains": [
          "7 floored unit(s), 185800 outstanding"
        ]
      }
    },
    {
      "id": "bad-schedule-step-refused",
      "tool": "curtailments_schedule",
      "args": {
        "statement": "fixtures/statement.csv",
        "schedule": [
          {
            "day": 0,
            "pct": 10
          }
        ]
      },
      "expect": {
        "status": "error",
        "contains": [
          "schedule"
        ]
      }
    },
    {
      "id": "policy-invented-tool-refused",
      "tool": "curtailments_pay_and_post_everything_now",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "policy-refuses-lender-portal-pay",
      "tool": "lender_portal_pay",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "policy-refuses-dms-change-inventory",
      "tool": "dms_change_inventory",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "policy-file-outside-root-refused",
      "tool": "curtailments_schedule",
      "args": {
        "statement": "../../../outside/export.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "error",
        "contains": [
          "outside"
        ]
      }
    },
    {
      "id": "policy-missing-argument-named",
      "tool": "curtailments_schedule",
      "args": {},
      "expect": {
        "status": "error",
        "contains": [
          "statement"
        ]
      }
    },
    {
      "id": "policy-review-mode-still-reads",
      "tool": "curtailments_schedule",
      "mode": "review",
      "args": {
        "statement": "fixtures/statement.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.units": 7,
          "result.balance": 185800,
          "result.overdue_units": 3,
          "result.overdue_amount": 17100,
          "result.due_soon_units": 2,
          "result.due_soon_amount": 4500
        }
      }
    },
    {
      "id": "policy-review-mode-still-reports",
      "tool": "curtailments_write_report",
      "mode": "review",
      "args": {
        "statement": "fixtures/statement.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "executed",
        "length": {
          "result.files": 2
        }
      }
    },
    {
      "id": "intl-de-totals",
      "tool": "curtailments_schedule",
      "args": {
        "statement": "fixtures/intl/de/statement.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "equals": {
          "result.units": 7,
          "result.balance": 185800,
          "result.overdue_units": 3,
          "result.overdue_amount": 17100,
          "result.due_soon_units": 2,
          "result.due_soon_amount": 4500
        }
      },
      "note": "German export of the same data (fixtures/intl/de); must match the English case \"totals\"."
    },
    {
      "id": "intl-ja-totals",
      "tool": "curtailments_schedule",
      "args": {
        "statement": "fixtures/intl/ja/statement.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "equals": {
          "result.units": 7,
          "result.balance": 185800,
          "result.overdue_units": 3,
          "result.overdue_amount": 17100,
          "result.due_soon_units": 2,
          "result.due_soon_amount": 4500
        }
      },
      "note": "Japanese export of the same data (fixtures/intl/ja); must match the English case \"totals\"."
    }
  ]
}
