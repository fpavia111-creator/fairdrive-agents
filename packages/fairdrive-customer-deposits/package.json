    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairdrive-customer-deposits": "bin/fairdrive-customer-deposits.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairdrive-customer-deposits.js demo",
    "eval": "node bin/fairdrive-customer-deposits.js eval"
  },
  "dependencies": {
    "fairdrive-core": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairdrive-agents.git",
    "directory": "packages/fairdrive-customer-deposits"
  },
