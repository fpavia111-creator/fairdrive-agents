{"suite":"fairdrive-estimate-vs-invoice","root":"..","data_note":"Fictional collision estimates and invoices in ../fixtures (insurers are made up), as of 2026-11-15. No model is called.","pii_canaries":["Quintus Arbogast","Sylvester Moncrieff","Tabitha Wexford","Ulysses Penhaligon"],"cases":[
{"id":"totals","tool":"estimates_compare","args":{"estimates":"fixtures/estimates.csv","invoices":"fixtures/invoices.csv","as_of":"2026-11-15"},"expect":{"equals":{"result.repairs":6,"result.estimated":22320,"result.invoiced":19600,"result.over_estimate":1,"result.over_amount":230,"result.under_estimate":1,"result.under_amount":350,"result.no_estimate":1,"result.not_invoiced":1,"result.not_invoiced_amount":3800}}},
{"id":"largest-first","tool":"estimates_compare","args":{"estimates":"fixtures/estimates.csv","invoices":"fixtures/invoices.csv","as_of":"2026-11-15"},"expect":{"equals":{"result.items.0.ro_number":"B1005","result.items.1.finding":"no_estimate","result.items.2.ro_number":"B1004","result.items.3.latest_version":"S01"},"length":{"result.items":4}}},
{"id":"supplement-is-the-estimate","tool":"estimates_compare","args":{"estimates":"fixtures/estimates.csv","invoices":"fixtures/invoices.csv","as_of":"2026-11-15"},"expect":{"not_contains":["\"B1001\"","\"B1002\""]}},
{"id":"categories","tool":"estimates_compare","args":{"estimates":"fixtures/estimates.csv","invoices":"fixtures/invoices.csv","as_of":"2026-11-15"},"expect":{"contains":["labor +100","parts +100","materials +30","labor -200","parts -150"]}},
{"id":"looser-tolerance","tool":"estimates_compare","args":{"estimates":"fixtures/estimates.csv","invoices":"fixtures/invoices.csv","as_of":"2026-11-15","tolerance":300},"expect":{"equals":{"result.over_estimate":0,"result.under_estimate":1}}},
{"id":"longer-invoice-window","tool":"estimates_compare","args":{"estimates":"fixtures/estimates.csv","invoices":"fixtures/invoices.csv","as_of":"2026-11-15","invoice_days":90},"expect":{"equals":{"result.not_invoiced":0}}},
{"id":"write-report","tool":"estimates_write_report","args":{"estimates":"fixtures/estimates.csv","invoices":"fixtures/invoices.csv","as_of":"2026-11-15"},"expect":{"status":"executed","length":{"result.files":2},"contains":["6 repair(s): estimated 22320, invoiced 19600"]}},
{"id":"missing-invoices-named","tool":"estimates_compare","args":{"estimates":"fixtures/estimates.csv"},"expect":{"status":"error","contains":["invoices"]}}
