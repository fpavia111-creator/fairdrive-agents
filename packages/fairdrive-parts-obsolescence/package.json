    "./package.json": "./package.json"
  },
  "bin": {
    "fairdrive-parts-obsolescence": "bin/fairdrive-parts-obsolescence.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
