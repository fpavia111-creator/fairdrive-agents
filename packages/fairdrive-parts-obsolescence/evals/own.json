{"id":"by-class","tool":"obsolescence_check","args":{"parts":"fixtures/parts.csv","as_of":"2026-11-15"},"expect":{"equals":{"result.by_class.0.value":832,"result.by_class.1.value":426,"result.by_class.2.value":610,"result.by_class.3.parts":2}}},
{"id":"highest-value-first","tool":"obsolescence_check","args":{"parts":"fixtures/parts.csv","as_of":"2026-11-15"},"expect":{"equals":{"result.items.0.part_number":"MOD-BCM-2290","result.items.0.class":"obsolete_candidate","result.items.1.part_number":"SNS-O2-7781","result.items.2.never_sold":true},"length":{"result.items":4}}},
{"id":"no-stock-and-active-not-listed","tool":"obsolescence_check","args":{"parts":"fixtures/parts.csv","as_of":"2026-11-15"},"expect":{"not_contains":["BLB-H11","\"FLT-OIL-1120\""]}},
