{
  "suite": "fairdrive-deal-jackets",
  "root": "..",
  "data_note": "Fictional deals and scanned documents in ../fixtures, as of 2026-11-15. No model is called.",
  "pii_canaries": [
    "Dana Whitfield",
    "Marcus Oyelaran",
    "Cormac Delahunt",
    "Bettina Okafor",
    "Rafael Quintero"
  ],
  "cases": [
    {
      "id": "totals",
      "tool": "jackets_check_jackets",
      "args": {
        "deals": "fixtures/deals.csv",
        "documents": "fixtures/documents.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "equals": {
          "result.deals": 9,
          "result.incomplete": 6,
          "result.complete": 3,
          "result.missing_documents": 18,
          "result.unsigned_documents": 2,
          "result.oldest_incomplete_days": 40,
          "result.skipped_unwound": 1
        }
      }
    },
    {
      "id": "worst-jacket-first",
      "tool": "jackets_check_jackets",
      "args": {
        "deals": "fixtures/deals.csv",
        "documents": "fixtures/documents.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "equals": {
          "result.items.0.deal_number": "D1010",
          "result.items.0.gaps": 11,
          "result.items.1.deal_number": "D1002"
        }
      }
    },
    {
      "id": "planted-gaps-named",
      "tool": "jackets_check_jackets",
      "args": {
        "deals": "fixtures/deals.csv",
        "documents": "fixtures/documents.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "contains": [
          "Buyers Guide (window form)",
          "Power of attorney",
          "Lease agreement",
          "OFAC check record",
          "Retail installment contract",
          "We Owe form",
          "D1099"
        ]
      }
    },
    {
      "id": "other-names-for-documents-count",
      "tool": "jackets_check_jackets",
      "args": {
        "deals": "fixtures/deals.csv",
        "documents": "fixtures/documents.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "not_contains": [
          "\"D1008\"",
          "\"D1001\"",
          "D1005"
        ]
      }
    },
    {
      "id": "store-keeps-licence-copies-elsewhere",
      "tool": "jackets_check_jackets",
      "args": {
        "deals": "fixtures/deals.csv",
        "documents": "fixtures/documents.csv",
        "as_of": "2026-11-15",
        "not_required": [
          "drivers_license",
          "insurance"
        ]
      },
      "expect": {
        "equals": {
          "result.incomplete": 5,
          "result.missing_documents": 14
        }
      }
    },
    {
      "id": "store-requires-buyers-guide-on-new-cars",
      "tool": "jackets_check_jackets",
      "args": {
        "deals": "fixtures/deals.csv",
        "documents": "fixtures/documents.csv",
        "as_of": "2026-11-15",
        "extra_documents": [
          "buyers_guide"
        ]
      },
      "expect": {
        "equals": {
          "result.complete": 1,
          "result.incomplete": 8
        }
      }
    },
    {
      "id": "write-report",
      "tool": "jackets_write_report",
      "args": {
        "deals": "fixtures/deals.csv",
        "documents": "fixtures/documents.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "executed",
        "length": {
          "result.files": 2
        },
        "contains": [
          "9 deal(s) checked: 6 incomplete"
        ]
      }
    },
    {
      "id": "unknown-document-code-refused",
      "tool": "jackets_check_jackets",
      "args": {
        "deals": "fixtures/deals.csv",
        "documents": "fixtures/documents.csv",
        "extra_documents": [
          "tax_return"
        ]
      },
      "expect": {
        "status": "error",
        "contains": [
          "extra_documents"
        ]
      }
    },
    {
      "id": "policy-invented-tool-refused",
      "tool": "jackets_pay_and_post_everything_now",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "policy-refuses-dms-book-deal",
      "tool": "dms_book_deal",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "policy-refuses-esign-send-envelope",
      "tool": "esign_send_envelope",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "policy-file-outside-root-refused",
      "tool": "jackets_check_jackets",
      "args": {
        "deals": "../../../outside/export.csv",
        "documents": "fixtures/documents.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "error",
        "contains": [
          "outside"
        ]
      }
    },
    {
      "id": "policy-missing-argument-named",
      "tool": "jackets_check_jackets",
      "args": {},
      "expect": {
        "status": "error",
        "contains": [
          "deals"
        ]
      }
    },
    {
      "id": "policy-review-mode-still-reads",
      "tool": "jackets_check_jackets",
      "mode": "review",
      "args": {
        "deals": "fixtures/deals.csv",
        "documents": "fixtures/documents.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.deals": 9,
          "result.incomplete": 6,
          "result.complete": 3,
          "result.missing_documents": 18,
          "result.unsigned_documents": 2,
          "result.oldest_incomplete_days": 40,
          "result.skipped_unwound": 1
        }
      }
    },
    {
      "id": "policy-review-mode-still-reports",
      "tool": "jackets_write_report",
      "mode": "review",
      "args": {
        "deals": "fixtures/deals.csv",
        "documents": "fixtures/documents.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "executed",
        "length": {
          "result.files": 2
        }
      }
    }
  ]
}
