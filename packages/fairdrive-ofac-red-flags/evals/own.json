{"suite": "fairdrive-ofac-red-flags", "root": "..", "data_note": "Fictional deals and check log in ../fixtures, October 2026. Record presence only; no check is run and no result is read. No model is called.", "pii_canaries": ["Bartram Oyelaran", "Cressida Oyelaran", "Eulalia Prentiss", "Fabian Lockridge"], "cases": [{"id": "totals", "tool": "redflags_check", "args": {"deals": "fixtures/deals.csv", "checks": "fixtures/checks.csv"}, "expect": {"equals": {"result.deals": 6, "result.skipped_unwound": 1, "result.deals_with_gaps": 4, "result.ofac_missing": 1, "result.ofac_after_delivery": 1, "result.co_buyer_not_checked": 1, "result.red_flags_missing": 1, "result.result_not_recorded": 1}}}, {"id": "gaps-by-deal", "tool": "redflags_check", "args": {"deals": "fixtures/deals.csv", "checks": "fixtures/checks.csv"}, "expect": {"equals": {"result.items.0.deal_number": "D17002", "result.items.0.gaps.0": "co_buyer_not_checked", "result.items.1.gaps.0": "ofac_after_delivery", "result.items.2.gaps.0": "ofac_missing", "result.items.2.gaps.1": "result_not_recorded", "result.items.3.gaps.0": "red_flags_missing"}, "length": {"result.items": 4}}}, {"id": "no-determination-language", "tool": "redflags_check", "args": {"deals": "fixtures/deals.csv", "checks": "fixtures/checks.csv"}, "expect": {"contains": ["not a compliance determination"], "not_contains": ["compliant\"", "is compliant", "violat"]}}, {"id": "clean-and-unwound-not-listed", "tool": "redflags_check", "args": {"deals": "fixtures/deals.csv", "checks": "fixtures/checks.csv"}, "expect": {"not_contains": ["\"D17001\"", "\"D17006\"", "\"D17007\""]}}, {"id": "write-report", "tool": "redflags_write_report", "args": {"deals": "fixtures/deals.csv", "checks": "fixtures/checks.csv"}, "expect": {"status": "executed", "length": {"result.files": 2}, "contains": ["6 deal(s), 4 with a record gap"]}}, {"id": "missing-checks-named", "tool": "redflags_check", "args": {"deals": "fixtures/deals.csv"}, "expect": {"status": "error", "contains": ["checks"]}}, {"id": "never-clears-a-match", "tool": "ofac_clear_match", "mode": "auto", "args": {}, "expect": {"status": "blocked", "contains": ["never clears"]}}, {"id": "wrong-file-for-checks-says-so", "tool": "redflags_check", "args": {"deals": "fixtures/deals.csv", "checks": "fixtures/deals.csv"}, "expect": {"status": "executed", "equals": {"result.ofac_missing": 6}, "contains": ["check_type"]}}]}
