{
  "suite": "fairdrive-used-vehicle-aging",
  "root": "..",
  "data_note": "Fictional used inventory in ../fixtures (makes and models are made up), as of 2026-11-15. No model is called.",
  "pii_none": "Reads vehicle inventory: stock numbers, VINs, costs and prices, no customer data.",
  "cases": [
    {
      "id": "totals",
      "tool": "aging_check",
      "args": {
        "inventory": "fixtures/used-inventory.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "equals": {
          "result.units": 6,
          "result.skipped_sold": 1,
          "result.total_cost": 122300,
          "result.average_age": 48,
          "result.over_wholesale_age": 2,
          "result.over_wholesale_cost": 32300,
          "result.priced_above_market": 1,
          "result.priced_well_below_market": 1,
          "result.price_below_cost": 1,
          "result.stale_price": 2,
          "result.no_price": 1
        }
      }
    },
    {
      "id": "oldest-first",
      "tool": "aging_check",
      "args": {
        "inventory": "fixtures/used-inventory.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "equals": {
          "result.items.0.stock_number": "U7004",
          "result.items.0.age_days": 106,
          "result.items.1.stock_number": "U7002",
          "result.items.1.price_to_market_pct": 107.98
        },
        "length": {
          "result.items": 5
        }
      }
    },
    {
      "id": "by-age",
      "tool": "aging_check",
      "args": {
        "inventory": "fixtures/used-inventory.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "equals": {
          "result.by_age.0.units": 2,
          "result.by_age.0.cost": 49000,
          "result.by_age.2.cost": 22500,
          "result.by_age.3.cost": 9800
        }
      }
    },
    {
      "id": "well-priced-and-sold-units-not-listed",
      "tool": "aging_check",
      "args": {
        "inventory": "fixtures/used-inventory.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "not_contains": [
          "U7001",
          "U7007"
        ]
      }
    },
    {
      "id": "store-wholesale-line",
      "tool": "aging_check",
      "args": {
        "inventory": "fixtures/used-inventory.csv",
        "as_of": "2026-11-15",
        "wholesale_days": 45
      },
      "expect": {
        "equals": {
          "result.over_wholesale_age": 2
        }
      }
    },
    {
      "id": "tighter-market-band",
      "tool": "aging_check",
      "args": {
        "inventory": "fixtures/used-inventory.csv",
        "as_of": "2026-11-15",
        "above_market_pct": 101
      },
      "expect": {
        "equals": {
          "result.priced_above_market": 2
        }
      }
    },
    {
      "id": "write-report",
      "tool": "aging_write_report",
      "args": {
        "inventory": "fixtures/used-inventory.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "executed",
        "length": {
          "result.files": 2
        },
        "contains": [
          "6 used unit(s) in stock, 122300 at cost"
        ]
      }
    },
    {
      "id": "longer-stale-window",
      "tool": "aging_check",
      "args": {
        "inventory": "fixtures/used-inventory.csv",
        "as_of": "2026-11-15",
        "stale_days": 60
      },
      "expect": {
        "equals": {
          "result.stale_price": 0
        }
      }
    },
    {
      "id": "policy-invented-tool-refused",
      "tool": "aging_pay_and_post_everything_now",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "policy-refuses-dms-change-price",
      "tool": "dms_change_price",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "policy-refuses-auction-list-vehicle",
      "tool": "auction_list_vehicle",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "policy-file-outside-root-refused",
      "tool": "aging_check",
      "args": {
        "inventory": "../../../outside/export.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "error",
        "contains": [
          "outside"
        ]
      }
    },
    {
      "id": "policy-missing-argument-named",
      "tool": "aging_check",
      "args": {},
      "expect": {
        "status": "error",
        "contains": [
          "inventory"
        ]
      }
    },
    {
      "id": "policy-review-mode-still-reads",
      "tool": "aging_check",
      "mode": "review",
      "args": {
        "inventory": "fixtures/used-inventory.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.units": 6,
          "result.skipped_sold": 1,
          "result.total_cost": 122300,
          "result.average_age": 48,
          "result.over_wholesale_age": 2,
          "result.over_wholesale_cost": 32300,
          "result.priced_above_market": 1,
          "result.priced_well_below_market": 1,
          "result.price_below_cost": 1,
          "result.stale_price": 2,
          "result.no_price": 1
        }
      }
    },
    {
      "id": "policy-review-mode-still-reports",
      "tool": "aging_write_report",
      "mode": "review",
      "args": {
        "inventory": "fixtures/used-inventory.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "executed",
        "length": {
          "result.files": 2
        }
      }
    },
    {
      "id": "intl-de-totals",
      "tool": "aging_check",
      "args": {
        "inventory": "fixtures/intl/de/used-inventory.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "equals": {
          "result.units": 6,
          "result.skipped_sold": 1,
          "result.total_cost": 122300,
          "result.average_age": 48,
          "result.over_wholesale_age": 2,
          "result.over_wholesale_cost": 32300,
          "result.priced_above_market": 1,
          "result.priced_well_below_market": 1,
          "result.price_below_cost": 1,
          "result.stale_price": 2,
          "result.no_price": 1
        }
      },
      "note": "German export of the same data (fixtures/intl/de); must match the English case \"totals\"."
    },
    {
      "id": "intl-ja-totals",
      "tool": "aging_check",
      "args": {
        "inventory": "fixtures/intl/ja/used-inventory.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "equals": {
          "result.units": 6,
          "result.skipped_sold": 1,
          "result.total_cost": 122300,
          "result.average_age": 48,
          "result.over_wholesale_age": 2,
          "result.over_wholesale_cost": 32300,
          "result.priced_above_market": 1,
          "result.priced_well_below_market": 1,
          "result.price_below_cost": 1,
          "result.stale_price": 2,
          "result.no_price": 1
        }
      },
      "note": "Japanese export of the same data (fixtures/intl/ja); must match the English case \"totals\"."
    }
  ]
}
