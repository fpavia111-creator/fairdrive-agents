{
  "suite": "fairdrive-sublet-invoices",
  "root": "..",
  "data_note": "Fictional sublet lines and vendor invoices in ../fixtures, as of 2026-11-15. No model is called.",
  "pii_none": "Reads RO, PO and invoice numbers, vendor names and amounts, no customer data.",
  "cases": [
    {
      "id": "totals",
      "tool": "sublet_match",
      "args": {
        "sublet_lines": "fixtures/sublet-lines.csv",
        "invoices": "fixtures/sublet-invoices.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "equals": {
          "result.sublet_lines": 6,
          "result.cost": 1330,
          "result.sale": 1540,
          "result.invoice_over_po": 1,
          "result.over_amount": 30,
          "result.closed_no_invoice": 1,
          "result.unbooked_cost": 410,
          "result.sold_below_cost": 1,
          "result.not_billed": 1,
          "result.duplicate_invoices": 1,
          "result.invoices_no_ro": 1
        }
      }
    },
    {
      "id": "largest-first",
      "tool": "sublet_match",
      "args": {
        "sublet_lines": "fixtures/sublet-lines.csv",
        "invoices": "fixtures/sublet-invoices.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "equals": {
          "result.items.0.ro_number": "91004",
          "result.items.0.finding": "closed_no_invoice",
          "result.items.1.finding": "invoice_no_ro",
          "result.items.5.amount": 20
        },
        "length": {
          "result.items": 6
        }
      }
    },
    {
      "id": "clean-and-open-lines-not-listed",
      "tool": "sublet_match",
      "args": {
        "sublet_lines": "fixtures/sublet-lines.csv",
        "invoices": "fixtures/sublet-invoices.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "not_contains": [
          "\"91001\"",
          "\"91006\""
        ]
      }
    },
    {
      "id": "longer-closed-window",
      "tool": "sublet_match",
      "args": {
        "sublet_lines": "fixtures/sublet-lines.csv",
        "invoices": "fixtures/sublet-invoices.csv",
        "as_of": "2026-11-15",
        "closed_days": 30
      },
      "expect": {
        "equals": {
          "result.closed_no_invoice": 0
        }
      }
    },
    {
      "id": "looser-tolerance",
      "tool": "sublet_match",
      "args": {
        "sublet_lines": "fixtures/sublet-lines.csv",
        "invoices": "fixtures/sublet-invoices.csv",
        "as_of": "2026-11-15",
        "tolerance": 40
      },
      "expect": {
        "equals": {
          "result.invoice_over_po": 0,
          "result.sold_below_cost": 0
        }
      }
    },
    {
      "id": "gross",
      "tool": "sublet_match",
      "args": {
        "sublet_lines": "fixtures/sublet-lines.csv",
        "invoices": "fixtures/sublet-invoices.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "equals": {
          "result.gross": 210
        }
      }
    },
    {
      "id": "write-report",
      "tool": "sublet_write_report",
      "args": {
        "sublet_lines": "fixtures/sublet-lines.csv",
        "invoices": "fixtures/sublet-invoices.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "executed",
        "length": {
          "result.files": 2
        },
        "contains": [
          "6 sublet line(s): cost 1330, sold 1540"
        ]
      }
    },
    {
      "id": "bad-tolerance-refused",
      "tool": "sublet_match",
      "args": {
        "sublet_lines": "fixtures/sublet-lines.csv",
        "invoices": "fixtures/sublet-invoices.csv",
        "tolerance": -1
      },
      "expect": {
        "status": "error",
        "contains": [
          "tolerance"
        ]
      }
    },
    {
      "id": "policy-invented-tool-refused",
      "tool": "sublet_pay_and_post_everything_now",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "policy-refuses-ap-pay-invoice",
      "tool": "ap_pay_invoice",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "policy-refuses-dms-close-ro",
      "tool": "dms_close_ro",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "policy-file-outside-root-refused",
      "tool": "sublet_match",
      "args": {
        "sublet_lines": "../../../outside/export.csv",
        "invoices": "fixtures/sublet-invoices.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "error",
        "contains": [
          "outside"
        ]
      }
    },
    {
      "id": "policy-missing-argument-named",
      "tool": "sublet_match",
      "args": {},
      "expect": {
        "status": "error",
        "contains": [
          "sublet_lines"
        ]
      }
    },
    {
      "id": "policy-review-mode-still-reads",
      "tool": "sublet_match",
      "mode": "review",
      "args": {
        "sublet_lines": "fixtures/sublet-lines.csv",
        "invoices": "fixtures/sublet-invoices.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.sublet_lines": 6,
          "result.cost": 1330,
          "result.sale": 1540,
          "result.invoice_over_po": 1,
          "result.over_amount": 30,
          "result.closed_no_invoice": 1,
          "result.unbooked_cost": 410,
          "result.sold_below_cost": 1,
          "result.not_billed": 1,
          "result.duplicate_invoices": 1,
          "result.invoices_no_ro": 1
        }
      }
    },
    {
      "id": "policy-review-mode-still-reports",
      "tool": "sublet_write_report",
      "mode": "review",
      "args": {
        "sublet_lines": "fixtures/sublet-lines.csv",
        "invoices": "fixtures/sublet-invoices.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "executed",
        "length": {
          "result.files": 2
        }
      }
    },
    {
      "id": "intl-de-totals",
      "tool": "sublet_match",
      "args": {
        "sublet_lines": "fixtures/intl/de/sublet-lines.csv",
        "invoices": "fixtures/intl/de/sublet-invoices.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "equals": {
          "result.sublet_lines": 6,
          "result.cost": 1330,
          "result.sale": 1540,
          "result.invoice_over_po": 1,
          "result.over_amount": 30,
          "result.closed_no_invoice": 1,
          "result.unbooked_cost": 410,
          "result.sold_below_cost": 1,
          "result.not_billed": 1,
          "result.duplicate_invoices": 1,
          "result.invoices_no_ro": 1
        }
      },
      "note": "German export of the same data (fixtures/intl/de); must match the English case \"totals\"."
    },
    {
      "id": "intl-ja-totals",
      "tool": "sublet_match",
      "args": {
        "sublet_lines": "fixtures/intl/ja/sublet-lines.csv",
        "invoices": "fixtures/intl/ja/sublet-invoices.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "equals": {
          "result.sublet_lines": 6,
          "result.cost": 1330,
          "result.sale": 1540,
          "result.invoice_over_po": 1,
          "result.over_amount": 30,
          "result.closed_no_invoice": 1,
          "result.unbooked_cost": 410,
          "result.sold_below_cost": 1,
          "result.not_billed": 1,
          "result.duplicate_invoices": 1,
          "result.invoices_no_ro": 1
        }
      },
      "note": "Japanese export of the same data (fixtures/intl/ja); must match the English case \"totals\"."
    }
  ]
}
