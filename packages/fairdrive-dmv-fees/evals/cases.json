{
  "suite": "fairdrive-dmv-fees",
  "root": "..",
  "data_note": "Fictional deals and tag agency charges in ../fixtures, as of 2026-11-15. No model is called.",
  "pii_canaries": [
    "Benedict Okoro",
    "Celia Marchetti",
    "Dorian Halloway",
    "Fergus Delacroix"
  ],
  "cases": [
    {
      "id": "totals",
      "tool": "dmvfees_reconcile",
      "args": {
        "deals": "fixtures/deals.csv",
        "charges": "fixtures/dmv-charges.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "equals": {
          "result.deals": 6,
          "result.collected": 1957.5,
          "result.charged": 1340.25,
          "result.overcollected": 1,
          "result.overcollected_amount": 50,
          "result.undercollected": 1,
          "result.undercollected_amount": 35.75,
          "result.not_paid_yet": 1,
          "result.not_paid_amount": 298,
          "result.charges_without_deal": 1,
          "result.charges_without_deal_amount": 199
        }
      }
    },
    {
      "id": "largest-first",
      "tool": "dmvfees_reconcile",
      "args": {
        "deals": "fixtures/deals.csv",
        "charges": "fixtures/dmv-charges.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "equals": {
          "result.items.0.deal_number": "D12004",
          "result.items.1.finding": "charge_without_deal",
          "result.items.2.deal_number": "D12002",
          "result.items.3.amount": 35.75
        },
        "length": {
          "result.items": 4
        }
      }
    },
    {
      "id": "vin-tail-charges-add-up",
      "tool": "dmvfees_reconcile",
      "args": {
        "deals": "fixtures/deals.csv",
        "charges": "fixtures/dmv-charges.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "not_contains": [
          "D12006",
          "\"D12001\"",
          "D12005"
        ]
      }
    },
    {
      "id": "longer-paid-window",
      "tool": "dmvfees_reconcile",
      "args": {
        "deals": "fixtures/deals.csv",
        "charges": "fixtures/dmv-charges.csv",
        "as_of": "2026-11-15",
        "paid_days": 60
      },
      "expect": {
        "equals": {
          "result.not_paid_yet": 0
        }
      }
    },
    {
      "id": "later-date",
      "tool": "dmvfees_reconcile",
      "args": {
        "deals": "fixtures/deals.csv",
        "charges": "fixtures/dmv-charges.csv",
        "as_of": "2026-12-20"
      },
      "expect": {
        "equals": {
          "result.not_paid_yet": 2,
          "result.not_paid_amount": 603
        }
      }
    },
    {
      "id": "looser-tolerance",
      "tool": "dmvfees_reconcile",
      "args": {
        "deals": "fixtures/deals.csv",
        "charges": "fixtures/dmv-charges.csv",
        "as_of": "2026-11-15",
        "tolerance": 40
      },
      "expect": {
        "equals": {
          "result.undercollected": 0,
          "result.overcollected": 1
        }
      }
    },
    {
      "id": "write-report",
      "tool": "dmvfees_write_report",
      "args": {
        "deals": "fixtures/deals.csv",
        "charges": "fixtures/dmv-charges.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "executed",
        "length": {
          "result.files": 2
        },
        "contains": [
          "6 deal(s): fees collected 1957.5, charged 1340.25"
        ]
      }
    },
    {
      "id": "bad-window-refused",
      "tool": "dmvfees_reconcile",
      "args": {
        "deals": "fixtures/deals.csv",
        "charges": "fixtures/dmv-charges.csv",
        "paid_days": 0
      },
      "expect": {
        "status": "error",
        "contains": [
          "paid_days"
        ]
      }
    },
    {
      "id": "policy-invented-tool-refused",
      "tool": "dmvfees_pay_and_post_everything_now",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "policy-refuses-ap-issue-refund",
      "tool": "ap_issue_refund",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "policy-refuses-dmv-submit-payment",
      "tool": "dmv_submit_payment",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "policy-file-outside-root-refused",
      "tool": "dmvfees_reconcile",
      "args": {
        "deals": "../../../outside/export.csv",
        "charges": "fixtures/dmv-charges.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "error",
        "contains": [
          "outside"
        ]
      }
    },
    {
      "id": "policy-missing-argument-named",
      "tool": "dmvfees_reconcile",
      "args": {},
      "expect": {
        "status": "error",
        "contains": [
          "deals"
        ]
      }
    },
    {
      "id": "policy-review-mode-still-reads",
      "tool": "dmvfees_reconcile",
      "mode": "review",
      "args": {
        "deals": "fixtures/deals.csv",
        "charges": "fixtures/dmv-charges.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.deals": 6,
          "result.collected": 1957.5,
          "result.charged": 1340.25,
          "result.overcollected": 1,
          "result.overcollected_amount": 50,
          "result.undercollected": 1,
          "result.undercollected_amount": 35.75,
          "result.not_paid_yet": 1,
          "result.not_paid_amount": 298,
          "result.charges_without_deal": 1,
          "result.charges_without_deal_amount": 199
        }
      }
    },
    {
      "id": "policy-review-mode-still-reports",
      "tool": "dmvfees_write_report",
      "mode": "review",
      "args": {
        "deals": "fixtures/deals.csv",
        "charges": "fixtures/dmv-charges.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "status": "executed",
        "length": {
          "result.files": 2
        }
      }
    },
    {
      "id": "intl-de-totals",
      "tool": "dmvfees_reconcile",
      "args": {
        "deals": "fixtures/intl/de/deals.csv",
        "charges": "fixtures/intl/de/dmv-charges.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "equals": {
          "result.deals": 6,
          "result.collected": 1957.5,
          "result.charged": 1340.25,
          "result.overcollected": 1,
          "result.overcollected_amount": 50,
          "result.undercollected": 1,
          "result.undercollected_amount": 35.75,
          "result.not_paid_yet": 1,
          "result.not_paid_amount": 298,
          "result.charges_without_deal": 1,
          "result.charges_without_deal_amount": 199
        }
      },
      "note": "German export of the same data (fixtures/intl/de); must match the English case \"totals\"."
    },
    {
      "id": "intl-ja-totals",
      "tool": "dmvfees_reconcile",
      "args": {
        "deals": "fixtures/intl/ja/deals.csv",
        "charges": "fixtures/intl/ja/dmv-charges.csv",
        "as_of": "2026-11-15"
      },
      "expect": {
        "equals": {
          "result.deals": 6,
          "result.collected": 1957.5,
          "result.charged": 1340.25,
          "result.overcollected": 1,
          "result.overcollected_amount": 50,
          "result.undercollected": 1,
          "result.undercollected_amount": 35.75,
          "result.not_paid_yet": 1,
          "result.not_paid_amount": 298,
          "result.charges_without_deal": 1,
          "result.charges_without_deal_amount": 199
        }
      },
      "note": "Japanese export of the same data (fixtures/intl/ja); must match the English case \"totals\"."
    }
  ]
}
