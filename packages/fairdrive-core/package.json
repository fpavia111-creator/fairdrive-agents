{
  "name": "fairdrive-core",
  "version": "0.1.1",
  "description": "Family kit (names, reading rules, data and domain helpers) on fair-agent-core for Fairdrive domain agents: pinned-model pack manifests, allow/ask/block policy, Review/Assist/Auto modes with caps and a kill switch, hash-chained JSONL audit logs, a zero-dependency stdio MCP server and fixture-based evals.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./testkit": "./src/testkit.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairdrive-approve": "bin/fairdrive-approve.js",
    "fairdrive-verify-log": "bin/fairdrive-verify-log.js",
    "fairdrive-new-agent": "bin/fairdrive-new-agent.js",
    "fairdrive-license": "bin/fairdrive-license.js"
  },
  "files": [
    "src",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairdrive-agents.git",
    "directory": "packages/fairdrive-core"
  },
  "homepage": "https://github.com/fpavia111-creator/fairdrive-agents/tree/master/packages/fairdrive-core#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/fairdrive-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai-agents",
    "guardrails",
    "human-in-the-loop",
    "audit-log",
    "fairdrive"
  ],
  "dependencies": {
    "fair-agent-core": "^8.0.0"
  }
}
